# TerraWatch Environment Configuration
APP_NAME="TerraWatch API"
APP_VERSION="1.0.0"
DEBUG=false

# 10 MB per image in bytes
MAX_UPLOAD_SIZE_BYTES=10485760

# Max sensor image dimensions and pixel count limits
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_PIXELS=16777216

# Server Host and Port
HOST=127.0.0.1
PORT=8000
